# Entra / Open WebUI
ENTRA_TENANT_ID=
GATEWAY_APP_ID=
WEBUI_CLIENT_ID=
WEBUI_CLIENT_SECRET=
WEBUI_SECRET_KEY=

# OpenCode Go (the local setup script reads this from ~/.pi/agent/auth.json)
UPSTREAM_MODEL=glm-5.3-flash
UPSTREAM_BASE_URL=https://opencode.ai/zen/go/v1
UPSTREAM_API_KEY=

# The local value is http://localhost:3000. Production uses the public URL.
WEBUI_URL=http://localhost:3000
OPENID_REDIRECT_URI=http://localhost:3000/oauth/oidc/callback
