# Copy to deploy/.env.infrastructure, chmod 600, and fill these values.
# provision.sh loads this file automatically. Values use shell syntax.
# HCLOUD_TOKEN=  # optional when an authenticated hcloud context is active
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCESS_EMAIL=

# Adopt the existing resources; do not create another tunnel.
CLOUDFLARE_TUNNEL_NAME=demo-llm-oauth
CLOUDFLARE_TUNNEL_ID=7f74c6f3-49cb-4195-96e5-dcbd3a861b87

# Optional overrides
HCLOUD_SERVER_TYPE=cpx22
HCLOUD_LOCATION=hel1
# CLOUDFLARE_ZONE=johancarlin.com
# CHAT_HOSTNAME=chat.johancarlin.com
# SSH_HOSTNAME=ssh.johancarlin.com
# GATEWAY_UI_HOSTNAME=gateway.johancarlin.com
